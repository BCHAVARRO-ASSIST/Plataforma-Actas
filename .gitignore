# Dependencias y artefactos generados
**/node_modules/
**/dist/
**/bin/
**/obj/
*.tsbuildinfo

# Configuracion local y secretos
.env
.env.*
!.env.example
**/appsettings.Development.json
!**/appsettings.Development.example.json
*.user
*.suo

# Herramientas y sistema operativo
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Respaldos y dumps de base de datos
*.dump
*.backup
*.sql.bak

# Runtime storage
storage/documentos/*
!storage/documentos/.gitkeep
