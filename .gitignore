# ==============================================================================
# .gitignore - Plataforma de Actas Monorepo (Production Hardened)
# Stack: ASP.NET Core 10 (C#), React 19 / Vite (TypeScript), PostgreSQL 17, Docker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Scripts de Prueba Temporales y Volátiles
# ------------------------------------------------------------------------------
test_*.ps1
test_*.sh
*.test.sh
*_test_battery.ps1
scripts/test_*
scripts/temp_*
scratch/
tools/*.ps1
tools/*.sh

# ------------------------------------------------------------------------------
# 2. Compilados y Artefactos de Build - .NET 10 / C#
# ------------------------------------------------------------------------------
**/bin/
**/obj/
**/Release/
**/Debug/
TestResults/
**/TestResults/
[Bb]in/
[Oo]bj/

# Archivos de usuario y estado de solución Visual Studio / JetBrains / VS Code
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.pidb
*.booproj
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
.fleet/
*.DotSettings.user

# ------------------------------------------------------------------------------
# 3. Dependencias y Builds Frontend - React 19 / Vite / Node
# ------------------------------------------------------------------------------
**/node_modules/
node_modules/
**/dist/
dist/
**/build/
build/
**/.vite/
.vite/
*.tsbuildinfo
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 4. Secretos, Variables de Entorno y Credenciales Criptográficas
# ------------------------------------------------------------------------------
**/.env
**/.env.*
!**/.env.example
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/appsettings.Development.json
!**/appsettings.Development.example.json
**/google-credentials*.json
**/Secrets/
**/Secrets/*.json
**/*.pfx
**/*.key
**/*.pem
**/*.cer
**/*.crt
cookies.txt
token.txt
*token*.txt
*cookie*.txt

# ------------------------------------------------------------------------------
# 5. Logs, Archivos Temporales y Reportes Efímeros
# ------------------------------------------------------------------------------
*.log
**/logs/
logs/
*.bak
*.tmp
*.orig
*.old
*.swp
*~
*.dump
*.backup
*.sql.bak
temp/
**/temp/
coverage/
**/coverage/
*.lcov

# ------------------------------------------------------------------------------
# 6. Archivos de Sistema Operativo
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# 7. Almacenamiento Persistente en Runtime (Storage de PDFs y Actas)
# ------------------------------------------------------------------------------
storage/
**/storage/
/app/storage/
storage/documentos/*
!storage/documentos/.gitkeep
**/storage/documentos/*
!**/storage/documentos/.gitkeep

# ------------------------------------------------------------------------------
# 8. Binarios y Ejecutables Nativos
# ------------------------------------------------------------------------------
*.exe
tools/*.exe
*.dll
!**/tests/**/*.dll.reference
