# ==============================================================================
# Git Ignore - Plataforma de Actas
# ==============================================================================

# Dependencias y artefactos generados de compilación
**/node_modules/
**/dist/
**/build/
**/bin/
**/obj/
**/.vite/
*.tsbuildinfo

# Configuración local, variables de entorno y secretos
**/.env
**/.env.*
!**/.env.example
**/.env.local
**/appsettings.Development.json
!**/appsettings.Development.example.json
**/google-credentials*.json
**/Secrets/
**/Secrets/*.json
**/*.pfx
**/*.key
**/*.pem
**/*.cer
**/*.crt
*.user
*.suo
cookies.txt
token.txt
*token*.txt
*cookie*.txt

# Archivos temporales y de respaldo
*.bak
*.tmp
*.orig
*.old
*.log

# Herramientas y metadatos de entorno / IDE
*.exe
tools/*.exe
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
.fleet/
.DS_Store
Thumbs.db

# Respaldos y dumps de base de datos
*.dump
*.backup
*.sql.bak

# Almacenamiento persistente de documentos en runtime
storage/documentos/*
!storage/documentos/.gitkeep
**/storage/documentos/*
!**/storage/documentos/.gitkeep
