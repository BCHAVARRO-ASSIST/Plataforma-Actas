# Dependencias y artefactos generados
**/node_modules/
**/dist/
**/bin/
**/obj/
*.tsbuildinfo

# Configuracion local y secretos
.env
.env.*
!.env.example
.env.local
**/appsettings.Development.json
!**/appsettings.Development.example.json
**/google-credentials*.json
**/Secrets/
**/Secrets/*.json
*.user
*.suo
cookies.txt
token.txt
*token*.txt
*cookie*.txt

# Archivos temporales y de respaldo
*.bak
*.tmp
*.orig
*.old
*.log

# Herramientas y sistema operativo
*.exe
tools/*.exe
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Respaldos y dumps de base de datos
*.dump
*.backup
