# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - PLATAFORMA DE ACTAS
# ==============================================================================
# Copie este archivo como '.env' en la raíz y defina las credenciales requeridas.
# NUNCA agregue credenciales reales ni contraseñas de producción en este archivo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL 17
# ------------------------------------------------------------------------------
POSTGRES_DB=plataforma_actas
POSTGRES_USER=plataforma_user
# OBLIGATORIO: Definir una contraseña segura de alta entropía
POSTGRES_PASSWORD=CHANGE_ME_SECURE_POSTGRES_PASSWORD
# Puerto expuesto en localhost para mantenimiento
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Seguridad y Tokens JWT (ASP.NET Core 10)
# ------------------------------------------------------------------------------
# OBLIGATORIO: Clave simétrica de al menos 32 caracteres (256 bits)
JWT_KEY=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_LONG_KEY
JWT_ISSUER=PlataformaActas.Api
JWT_AUDIENCE=PlataformaActas.Web
JWT_EXPIRES_MINUTES=30
ASPNETCORE_ENVIRONMENT=Production

# ------------------------------------------------------------------------------
# 3. Puertos de Servicio, CORS y Frontend
# ------------------------------------------------------------------------------
API_PORT=8080
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
VITE_API_URL=/api
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# 4. Integraciones con Google Cloud & Workspace
# ------------------------------------------------------------------------------
# Identificador de cliente OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Ruta del archivo de credenciales de Service Account en el contenedor
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/app/Secrets/google-credentials.json

# Cuentas autorizadas para Domain-Wide Delegation
GOOGLE_ADMIN_IMPERSONATION_EMAIL=soporte@assist.com.co
GOOGLE_GMAIL_IMPERSONATION_EMAIL=soporte@assist.com.co

# Identificador de la hoja de cálculo de Google Drive para sincronización de inventario
GOOGLE_DRIVE_FILE_ID=1IzIM5X_ph99Q_fw9T290IMFOpkZj5Qkc

# ------------------------------------------------------------------------------
# 5. Configuración de Correo Saliente (SMTP / Gmail de Respaldo)
# ------------------------------------------------------------------------------
# Variables estándar compatibles tanto en formato Unix (SMTP_*) como .NET (Smtp__*)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=soporte@assist.com.co
SMTP_FROM=soporte@assist.com.co
SMTP_FROM_NAME="Assist Consultores de Sistemas - Soporte IT"
SMTP_SOPORTE_EMAILS=soporte@assist.com.co
SMTP_APS_EMAILS=aps@assist.com.co

# Alternativamente, en formato jerárquico ASP.NET Core:
# Smtp__Host=smtp.gmail.com
# Smtp__Port=587
# Smtp__EnableSsl=true
# Smtp__User=
# Smtp__Password=
# Smtp__From=soporte@assist.com.co
# Smtp__FromName="Assist Consultores de Sistemas - Soporte IT"
