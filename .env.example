# =========================================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL
# =========================================================
POSTGRES_DB=plataforma_actas
POSTGRES_USER=plataforma_user
# OBLIGATORIO: Definir una contraseña de alta entropía (no usar valores por defecto)
POSTGRES_PASSWORD=DefinirPasswordSeguroAqui_2026!
# Puerto local en host (En producción se recomienda dejar solo accesible internamente)
POSTGRES_PORT=5432

# =========================================================
# CONFIGURACIÓN DE SEGURIDAD JWT (HS256 - Mínimo 256 bits)
# =========================================================
# OBLIGATORIO: Clave criptográfica de al menos 32 caracteres
JWT_KEY=ClaveSecretaCriptograficaMinimo32Caracteres_2026_Prod!
JWT_ISSUER=PlataformaActas.Api
JWT_AUDIENCE=PlataformaActas.Web
JWT_EXPIRES_MINUTES=30

# =========================================================
# PUERTOS Y ENRUTAMIENTO DE RED
# =========================================================
API_PORT=8080
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# =========================================================
# GOOGLE WORKSPACE OAUTH 2.0 / INTEGRACIONES
# =========================================================
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# =========================================================
# CONFIGURACIÓN DE CORREO SALIENTE (SMTP / NOTIFICACIONES)
# =========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=tu_correo_servicio@assist.com.co
SMTP_PASSWORD=tu_password_de_aplicacion
SMTP_FROM_EMAIL=soporte@assist.com.co
SMTP_FROM_NAME="Assist Consultores de Sistemas - Soporte IT"
SMTP_SOPORTE_EMAILS=soporte@assist.com.co
SMTP_APS_EMAILS=aps@assist.com.co
