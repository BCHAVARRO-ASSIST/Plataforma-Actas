**/.git
**/.github
**/.vs
**/.vscode
**/.idea

# Binarios y artefactos de compilación local
bin/
obj/
**/*.user
**/*.suo

# Secretos y credenciales
Secrets/
Secrets/*.json
**/*.key
**/*.pfx
**/*.pem

# Variables de entorno
.env*
!.env.example

# Documentos generados localmente
storage
storage/
/app/storage/
storage/documentos/*
!storage/documentos/.gitkeep

# Logs y temporales
*.log
*.tmp
*.doc
*.docx
*.pdf
temp/
logs/
.DS_Store
Thumbs.db

